<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.8'>
  <model name='rocket_base'>
    <pose>0 0 0 0 0 0</pose>
    <link name='rocket_base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
       <pose>0 0 0 0 0 0</pose>
       <mass>1.899</mass>
       <inertia>
         <ixx>0.14212</ixx>
         <ixy>0</ixy>
         <ixz>0</ixz>
         <iyy>0.14212</iyy>
         <iyz>0</iyz>
         <izz>0.00047</izz>
       </inertia>
      </inertial>
      <velocity_decay>
        <linear>0.01</linear>
        <angular>0.005</angular>
      </velocity_decay>
      <collision name='rocket_base_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07036</radius>
            <length>0.6096</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='rocket_base_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07036</radius>
            <length>0.6096</length>
          </cylinder>
       </geometry>
      </visual>
    </link>

    <link name='rocket_payload_link'>
      <pose>0 0 0.6096 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.425</mass>
        <inertia>
          <ixx>0.01463</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01463</iyy>
          <iyz>0</iyz>
          <izz>0.001992</izz>
        </inertia>
      </inertial>
      <collision name='rocket_payload_collsion_wall_0'>
        <pose>0 0.068429 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.140716 0.003858 0.6096</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name='rocket_payload_collsion_wall_1'>
        <pose>-0.068429 0 0 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.140716 0.003858 0.6096</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name='rocket_payload_collsion_wall_2'>
        <pose>0 -0.068429 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.140716 0.003858 0.6096</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name='rocket_payload_collsion_wall_3'>
        <pose>0.068429 0 0 0 0 1.57</pose>
        <geometry>
          <box>
            <size>0.140716 0.003858 0.6096</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='rocket_payload_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <!-- use a hollow mesh in the future -->
          <cylinder>
            <radius>0.07036</radius>
            <length>0.6096</length>
          </cylinder>
        </geometry>
      </visual>
    </link>   
     
    <joint name='rocket_base_payload_joint' type='fixed'>
      <parent>rocket_base_link</parent>
      <child>rocket_payload_link</child>
    </joint>
    
    <plugin
      filename="gz-sim-detachable-joint-system"
      name="gz::sim::systems::DetachableJoint">
      <parent_link>rocket_payload_link</parent_link>
      <child_model>rocket_cone</child_model>
      <child_link>rocket_cone_link</child_link>
      <detach_topic>/rocket/cone/detach</detach_topic>
    </plugin>
    
    <plugin
      filename="gz-sim-detachable-joint-system"
      name="gz::sim::systems::DetachableJoint">
      <parent_link>rocket_payload_link</parent_link>
      <child_model>container</child_model>
      <child_link>container_link</child_link>
      <detach_topic>/rocket/container/detach</detach_topic>
    </plugin>
  
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>
  
    <plugin filename="libJ425R.so" name="cansat::J425R"/>
    <plugin filename="libRocketRecovery.so" name="cansat::RocketRecovery"/>
  </model>
</sdf>
